NODE_ENV=development
PORT=8080
GOOGLE_CLOUD_PROJECT=your-project-id
GEMINI_API_KEY=replace-me
GEMINI_MODEL=gemini-3.6-flash
GOOGLE_MAPS_API_KEY=replace-me
ALLOWED_ORIGINS=http://localhost:5173

VITE_API_BASE_URL=/api
VITE_FIREBASE_API_KEY=replace-with-web-config
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=replace-with-web-app-id
VITE_USE_FIREBASE_EMULATORS=true
VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
VITE_FIREBASE_FIRESTORE_EMULATOR_HOST=127.0.0.1
VITE_FIREBASE_FIRESTORE_EMULATOR_PORT=8080
# Fastify must use this too when it verifies Auth-emulator ID tokens.
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# Development-only token shim; forced off in NODE_ENV=production.
ALLOW_LOCAL_AUTH=true
VITE_ENABLE_E2E_BRIDGE=false
